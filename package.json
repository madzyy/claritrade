{
  "name": "claritrade",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css,mjs}\"",
    "typecheck": "turbo typecheck",
    "db:studio": "pnpm --filter @workspace/db exec prisma studio",
    "postinstall": "pnpm --filter @workspace/db run generate"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.8.0",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
